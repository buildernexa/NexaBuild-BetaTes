# Set these in Vercel Project Settings -> Environment Variables. Do not commit a real token.
GITHUB_TOKEN=replace_with_a_fine_grained_token
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_builder_repository
GITHUB_DEFAULT_BRANCH=main
NEXABUILDER_ACCESS_KEY=replace_with_a_random_secret_at_least_32_characters
